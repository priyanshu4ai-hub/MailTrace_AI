# Keep external enrichment disabled unless the deployment has approved data sharing.
MAILTRACE_ENABLE_LLM_ENRICHMENT=false
MAILTRACE_ENABLE_GEO_OSINT=false

# Comma-separated browser origins allowed to call the API.
MAILTRACE_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Required only when MAILTRACE_ENABLE_LLM_ENRICHMENT=true.
GROQ_API_KEY=
